DATABASE_URL="postgresql://platform:platform@platform-db:5432/platform?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT="4000"
CORS_ORIGIN="http://localhost:3000"

# Docker executor
SANDBOX_VOLUME="platform_sub"
SANDBOX_MOUNT="/sub"
DOCKER_BIN="docker"
EXEC_PARALLELISM="4"
EXEC_CPU_LIMIT="1"
EXEC_PIDS_LIMIT="128"

# OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
